# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น (เพิ่ม/ปิดบัญชีผู้ใช้) — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit ค่าจริง
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
